VITE_APP_VERSION=v2.2.0
VITE_APP_BASE_NAME=/free
VITE_DEV_PORT=3000
VITE_API_PORT=5010

# PM2 manager API
PM2_MANAGER_HOST=0.0.0.0
PM2_MANAGER_PORT=5010
PM2_MANAGER_BASE_PATH=/free
# Set this to the browser origin when the UI and API are on different origins.
PM2_MANAGER_ORIGIN=
PM2_MANAGER_TRUST_PROXY=false
PM2_HOME=

# PostgreSQL (use DATABASE_URL instead if preferred)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=mantis
PGDATABASE=mantis_db
PGPASSWORD=replace-with-a-secret
DATABASE_SSL=false

# First Super Admin bootstrap account. Change after first login.
AUTH_ADMIN_USERNAME=Pawan
AUTH_ADMIN_PASSWORD=replace-with-a-12-character-secret
AUTH_ADMIN_DISPLAY_NAME=Super Admin
AUTH_COOKIE_SECURE=false

# Domain monitoring
DOMAIN_SCAN_ENABLED=true
DOMAIN_SCAN_INTERVAL_MINUTES=60
# Set to false to disable the separate project-directory webspace job.
WEBSPACE_CHECK_ENABLED=true
ALLOW_PRIVATE_DOMAIN_TARGETS=false

# SMTP domain-monitor reports (use a provider app password, not your mailbox password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reports@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM="Mantis Monitor <reports@example.com>"
# Optional; if empty, reports are sent to SMTP_USER
SMTP_REPORT_RECIPIENTS=

# Groq project analysis (server-side only)
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
